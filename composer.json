{
    "name": "astral-php/astral-utilities",
    "version": "0.2.0",
    "description": "Helpers cha\u00eenes, dates et tableaux pour Astral MVC \u2014 z\u00e9ro d\u00e9pendance.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "astral",
        "php",
        "utilities",
        "helpers",
        "string",
        "date",
        "array"
    ],
    "require": {
        "php": "^8.3"
    },
